    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.QuickStart"
        tools:targetApi="31">
        <activity
            android:name="com.kozen.quickstartks.TransInitActivity"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.kozen.quickstartks.action.PAY" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="pay"
                    android:scheme="quickstartks" />
            </intent-filter>
        </activity>

        <activity android:name=".BaseActivity"
            android:screenOrientation="portrait">
        </activity>

        <activity android:name="com.kozen.quickstartks.TransActivity"
            android:screenOrientation="portrait">
        </activity>
        <activity android:name="com.kozen.quickstartks.TransResultActivity"
            android:screenOrientation="portrait">
        </activity>

        <activity android:name="com.kozen.quickstartks.ScanPaymentActivity"
            android:screenOrientation="portrait">
        </activity>
        <activity android:name="com.kozen.quickstartks.TransScanResultActivity"
            android:screenOrientation="portrait">
        </activity>
        <activity android:name="com.kozen.quickstartks.TransSelectActivity"
            android:screenOrientation="portrait">
        </activity>
        <activity android:name="com.kozen.quickstartks.QrPaymentActivity"
            android:screenOrientation="portrait">
        </activity>

    </application>

</manifest>
