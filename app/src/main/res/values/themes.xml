<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Orange + dark-card light theme (keeps an ActionBar for BaseActivity's custom title). -->
    <style name="Theme.QuickStart" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <item name="colorPrimary">@color/mp_blue</item>
        <item name="colorPrimaryVariant">@color/mp_blue_dark</item>
        <item name="colorOnPrimary">@color/on_yellow</item>
        <item name="colorSecondary">@color/mp_blue</item>
        <item name="colorSecondaryVariant">@color/mp_blue_dark</item>
        <item name="colorOnSecondary">@color/on_yellow</item>
        <item name="colorAccent">@color/mp_blue</item>
        <item name="android:colorBackground">@color/page_bg</item>
        <item name="colorSurface">@color/card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:windowBackground">@color/page_bg</item>
        <item name="android:statusBarColor">@color/card</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="actionBarStyle">@style/Widget.QuickStart.ActionBar</item>
    </style>

    <style name="Widget.QuickStart.ActionBar" parent="Widget.MaterialComponents.ActionBar.Primary">
        <item name="background">@color/card</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Theme.QuickStart2" parent="Theme.QuickStart" />
</resources>
