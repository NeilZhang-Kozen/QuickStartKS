<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="16px"
    tools:ignore="MissingDefaultResource">

    <!-- Header brand image -->
<!--    <ImageView-->
<!--        android:layout_width="match_parent"-->
<!--        android:layout_height="wrap_content"-->
<!--        android:adjustViewBounds="true"-->
<!--        android:gravity="center"-->
<!--        android:scaleType="centerInside"-->
<!--        android:src="@drawable/receipt_pizzahut" />-->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10px"
        android:gravity="center"
        android:text="Mercado Pago"
        android:textColor="#000000"
        android:textSize="50px"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/tv_receipt_merchant"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10px"
        android:gravity="center"
        android:text=""
        android:textColor="#000000"
        android:textSize="22px"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6px"
        android:gravity="center"
        android:text="MERCHANT COPY"
        android:textColor="#000000"
        android:textSize="18px" />

    <TextView
        android:id="@+id/tv_receipt_transtype"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6px"
        android:gravity="center"
        android:text="SALE"
        android:textColor="#000000"
        android:textSize="22px"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="4px"
        android:layout_marginTop="14px"
        android:layout_marginBottom="14px"
        android:background="@drawable/bg_black_line2" />

    <!-- Detail rows -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3px"
            android:layout_marginBottom="3px"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="start"
                android:text="MERCHANT NO."
                android:textColor="#000000"
                android:textSize="18px" />
            <TextView
                android:id="@+id/tv_receipt_mid"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text=""
                android:textColor="#000000"
                android:textSize="18px" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3px"
            android:layout_marginBottom="3px"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="start"
                android:text="TERMINAL NO."
                android:textColor="#000000"
                android:textSize="18px" />
            <TextView
                android:id="@+id/tv_receipt_tid"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text=""
                android:textColor="#000000"
                android:textSize="18px" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3px"
            android:layout_marginBottom="3px"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="start"
                android:text="OPERATOR NO."
                android:textColor="#000000"
                android:textSize="18px" />
            <TextView
                android:id="@+id/tv_receipt_operator"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text=""
                android:textColor="#000000"
                android:textSize="18px" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3px"
            android:layout_marginBottom="3px"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="start"
                android:text="CARD NO."
                android:textColor="#000000"
                android:textSize="18px" />
            <TextView
                android:id="@+id/tv_receipt_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text=""
                android:textColor="#000000"
                android:textSize="18px" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3px"
            android:layout_marginBottom="3px"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="start"
                android:text="CARD TYPE"
                android:textColor="#000000"
                android:textSize="18px" />
            <TextView
                android:id="@+id/tv_receipt_brand"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text=""
                android:textColor="#000000"
                android:textSize="18px" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3px"
            android:layout_marginBottom="3px"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="start"
                android:text="EXPIRY DATE"
                android:textColor="#000000"
                android:textSize="18px" />
            <TextView
                android:id="@+id/tv_receipt_expiry"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text=""
                android:textColor="#000000"
                android:textSize="18px" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3px"
            android:layout_marginBottom="3px"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="start"
                android:text="BATCH NO."
                android:textColor="#000000"
                android:textSize="18px" />
            <TextView
                android:id="@+id/tv_receipt_batch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text=""
                android:textColor="#000000"
                android:textSize="18px" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3px"
            android:layout_marginBottom="3px"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="start"
                android:text="VOUCHER NO."
                android:textColor="#000000"
                android:textSize="18px" />
            <TextView
                android:id="@+id/tv_receipt_voucher"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text=""
                android:textColor="#000000"
                android:textSize="18px" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3px"
            android:layout_marginBottom="3px"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="start"
                android:text="REF NO."
                android:textColor="#000000"
                android:textSize="18px" />
            <TextView
                android:id="@+id/tv_receipt_ref"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text=""
                android:textColor="#000000"
                android:textSize="18px" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3px"
            android:layout_marginBottom="3px"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="start"
                android:text="AUTH CODE"
                android:textColor="#000000"
                android:textSize="18px" />
            <TextView
                android:id="@+id/tv_receipt_auth"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text=""
                android:textColor="#000000"
                android:textSize="18px" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3px"
            android:layout_marginBottom="3px"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="start"
                android:text="CUSTOMER"
                android:textColor="#000000"
                android:textSize="18px" />
            <TextView
                android:id="@+id/tv_receipt_customer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text=""
                android:textColor="#000000"
                android:textSize="18px" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3px"
            android:layout_marginBottom="3px"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="start"
                android:text="DATE/TIME"
                android:textColor="#000000"
                android:textSize="18px" />
            <TextView
                android:id="@+id/tv_receipt_datetime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text=""
                android:textColor="#000000"
                android:textSize="18px" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="4px"
        android:layout_marginTop="14px"
        android:layout_marginBottom="14px"
        android:background="@drawable/bg_black_line2" />

    <!-- Amount -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="start"
            android:text="AMOUNT"
            android:textColor="#000000"
            android:textSize="26px"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tv_receipt_amount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text=""
            android:textColor="#000000"
            android:textSize="26px"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Backwards-compatible total field (display path uses this too) -->
    <TextView
        android:id="@+id/tv_receipt_total"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="4px"
        android:layout_marginTop="14px"
        android:layout_marginBottom="14px"
        android:background="@drawable/bg_black_line2" />

    <!-- Barcode -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="70px"
        android:layout_marginTop="6px"
        android:background="@drawable/barcode_0"
        android:gravity="center" />

    <TextView
        android:id="@+id/tv_receipt_barcode_num"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4px"
        android:gravity="center"
        android:text="2220760000452201111327"
        android:textColor="#000000"
        android:textSize="15px"
        android:textStyle="bold" />

    <!-- Cardholder signature -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40px"
        android:text="CARDHOLDER SIGNATURE"
        android:textColor="#000000"
        android:textSize="18px" />

    <View
        android:layout_width="match_parent"
        android:layout_height="4px"
        android:layout_marginTop="6px"
        android:layout_marginBottom="10px"
        android:background="@drawable/bg_black_line2" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="I ACKNOWLEDGE SATISFACTORY RECEIPT OF RELATIVE GOODS / SERVICES"
        android:textColor="#000000"
        android:textSize="16px" />

    <View
        android:layout_width="match_parent"
        android:layout_height="4px"
        android:layout_marginTop="14px"
        android:layout_marginBottom="14px"
        android:background="@drawable/bg_black_line2" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:scaleX="0.9"
        android:text="@string/print_leader"
        android:textColor="#000000"
        android:textSize="20px"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6px"
        android:gravity="center"
        android:text="@string/print_introduce"
        android:textColor="#000000"
        android:textSize="18px" />

    <ImageView
        android:layout_width="180px"
        android:layout_height="wrap_content"
        android:layout_marginTop="20px"
        android:adjustViewBounds="true"
        android:gravity="center"
        android:scaleType="centerInside"
        android:src="@drawable/mercado_pago_qr" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4px"
        android:gravity="center"
        android:text="@string/print_website"
        android:textColor="#000000"
        android:textSize="18px" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24px"
        android:gravity="center"
        android:text="THANK YOU FOR VISITING!"
        android:textColor="#000000"
        android:textSize="20px"
        android:textStyle="bold" />
</LinearLayout>
