<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mp_blue"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="35px"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="180px"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="10px"
            android:layout_marginRight="10px"
            android:layout_weight="1"
            android:background="@drawable/bg_blue_stroke"
            android:focusable="false"
            android:gravity="center"
            android:onClick="onUSD"
            android:orientation="vertical"
            android:padding="20px">

            <TextView
                android:id="@+id/iv_result_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="$"
                android:textColor="@color/orange_solid"
                android:textSize="50px"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tv_result"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5px"
                android:gravity="center"
                android:text="@string/sub_usd"
                android:textColor="@color/text_primary"
                android:textSize="18px" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="180px"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="10px"
            android:layout_marginRight="10px"
            android:layout_weight="1"
            android:background="@drawable/bg_blue_stroke"
            android:focusable="false"
            android:gravity="center"
            android:onClick="onEUR"
            android:orientation="vertical"
            android:padding="20px">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="€"
                android:textColor="@color/orange_solid"
                android:textSize="50px"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5px"
                android:gravity="center"
                android:text="@string/sub_eur"
                android:textColor="@color/text_primary"
                android:textSize="18px" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_amount"
        android:layout_width="match_parent"
        android:layout_height="60px"
        android:layout_marginLeft="10px"
        android:layout_marginTop="35px"
        android:layout_marginRight="10px"
        android:background="@drawable/bg_round_dark"
        android:focusable="false"
        android:gravity="center"
        android:onClick="showPic"
        android:textColor="@color/white"
        android:textSize="22px"
        android:textStyle="bold" />
</LinearLayout>
