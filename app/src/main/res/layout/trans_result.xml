<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_page_gradient"
    android:orientation="vertical"
    tools:ignore="MissingDefaultResource,HardcodedText">

    <!-- Top header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/pos_header_padding_horizontal"
        android:paddingTop="@dimen/pos_header_padding_vertical"
        android:paddingRight="@dimen/pos_header_padding_horizontal"
        android:paddingBottom="@dimen/pos_header_padding_vertical">

        <TextView
            android:layout_width="@dimen/pos_logo_size"
            android:layout_height="@dimen/pos_logo_size"
            android:background="@drawable/bg_logo_circle_dark"
            android:gravity="center"
            android:text="@string/brand_logo_initial"
            android:textColor="@color/white"
            android:textSize="@dimen/pos_logo_text_size"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/brand_company"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/pos_brand_text_size"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/header_transaction_detail"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/pos_header_subtitle_text_size" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_green"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/pos_chip_padding_horizontal"
            android:paddingTop="@dimen/pos_chip_padding_vertical"
            android:paddingRight="@dimen/pos_chip_padding_horizontal"
            android:paddingBottom="@dimen/pos_chip_padding_vertical">

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_ring_core"
                android:backgroundTint="@color/badge_green_dot" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_paid"
                android:textColor="@color/badge_green_text"
                android:textSize="@dimen/pos_header_subtitle_text_size"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="@dimen/result_content_padding_horizontal"
            android:paddingRight="@dimen/result_content_padding_horizontal"
            android:paddingBottom="@dimen/result_content_padding_bottom">

            <!-- Dark hero result card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/result_hero_margin_top"
                android:background="@drawable/bg_card_dark"
                android:orientation="vertical"
                android:padding="@dimen/result_hero_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/iv_result_image"
                        android:layout_width="@dimen/result_icon_size"
                        android:layout_height="@dimen/result_icon_size"
                        android:adjustViewBounds="true"
                        android:scaleType="centerInside"
                        android:src="@drawable/result_success" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/result_text_margin_start"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_result"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/on_dark"
                            android:textSize="@dimen/result_title_text_size"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/result_subtitle_margin_top"
                            android:text="@string/result_transaction_done"
                            android:textColor="@color/on_dark_dim"
                            android:textSize="@dimen/result_subtitle_text_size" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/result_amount_margin_top"
                    android:textColor="@color/on_dark"
                    android:textSize="@dimen/result_amount_text_size"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_result_detail_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/result_receipt_chip_margin_top"
                    android:background="@drawable/bg_chip_dark"
                    android:paddingLeft="@dimen/result_receipt_chip_padding_horizontal"
                    android:paddingTop="@dimen/result_receipt_chip_padding_vertical"
                    android:paddingRight="@dimen/result_receipt_chip_padding_horizontal"
                    android:paddingBottom="@dimen/result_receipt_chip_padding_vertical"
                    android:text="@string/result_receipt_generated"
                    android:textColor="@color/on_dark"
                    android:textSize="@dimen/result_receipt_chip_text_size"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- White detail card -->
            <LinearLayout
                android:id="@+id/result_data_ll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/result_detail_margin_top"
                android:background="@drawable/bg_gray_stroke"
                android:orientation="vertical"
                android:padding="@dimen/result_detail_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/result_order_details"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/result_detail_title_text_size"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/row_result_primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/result_detail_row_margin_top"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_result_primary_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/trans_result_card_num"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/result_detail_text_size" />

                    <TextView
                        android:id="@+id/tv_card_number"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/result_detail_text_size" />
                </LinearLayout>

                <View
                    android:id="@+id/reslut_line"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/result_divider_margin_vertical"
                    android:layout_marginBottom="@dimen/result_divider_margin_vertical"
                    android:background="@color/divider" />

                <LinearLayout
                    android:id="@+id/row_result_secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_result_secondary_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/trans_result_customer"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/result_detail_text_size" />

                    <TextView
                        android:id="@+id/tv_card_user"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/result_detail_text_size" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tv_result_confirm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/result_print_margin_top"
                android:background="@drawable/blue_btn"
                android:gravity="center"
                android:padding="@dimen/result_print_padding"
                android:text="@string/trans_result_print"
                android:textAllCaps="false"
                android:textColor="@color/on_yellow"
                android:textSize="@dimen/result_print_text_size"
                android:textStyle="bold" />

            <ScrollView
                android:id="@+id/sl_receipt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/result_receipt_margin_top"
                android:background="@drawable/bg_gray_stroke2"
                android:scrollbars="none">

                <include layout="@layout/receipt_content" />
            </ScrollView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
