<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_sheet"
    android:orientation="vertical"
    android:paddingLeft="26dp"
    android:paddingTop="24dp"
    android:paddingRight="26dp"
    android:paddingBottom="28dp">

    <View
        android:layout_width="38dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_chip_dark" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/waiting_select_payment_method"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_payment_method_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/orange_solid"
        android:textSize="38sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/ll_payment_card"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_payment_option"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="18dp"
        android:paddingRight="18dp">

        <FrameLayout
            android:layout_width="@dimen/payment_icon_box_size"
            android:layout_height="@dimen/payment_icon_box_size"
            android:background="@drawable/bg_icon_orange_tint">

            <ImageView
                android:layout_width="@dimen/payment_icon_size"
                android:layout_height="@dimen/payment_icon_size"
                android:layout_gravity="center"
                android:adjustViewBounds="true"
                android:src="@drawable/icon_payment_card" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sub_trans_bank_card"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/header_secure_payment"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/icon_chevron_right"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_payment_qr"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_payment_option"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="18dp"
        android:paddingRight="18dp">

        <FrameLayout
            android:layout_width="@dimen/payment_icon_box_size"
            android:layout_height="@dimen/payment_icon_box_size"
            android:background="@drawable/bg_icon_orange_tint">

            <ImageView
                android:layout_width="@dimen/payment_icon_size"
                android:layout_height="@dimen/payment_icon_size"
                android:layout_gravity="center"
                android:adjustViewBounds="true"
                android:src="@drawable/icon_payment_scan" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sub_trans_pay_code"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/sub_trans_qr_tip"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/icon_chevron_right"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_payment_qr_display"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_payment_option"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="18dp"
        android:paddingRight="18dp">

        <FrameLayout
            android:layout_width="@dimen/payment_icon_box_size"
            android:layout_height="@dimen/payment_icon_box_size"
            android:background="@drawable/bg_icon_orange_tint">

            <ImageView
                android:layout_width="@dimen/payment_icon_size"
                android:layout_height="@dimen/payment_icon_size"
                android:layout_gravity="center"
                android:adjustViewBounds="true"
                android:src="@drawable/icon_payment_qr_display" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sub_trans_qr_display"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/qr_display_hint"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/icon_chevron_right"
            app:tint="@color/text_secondary" />
    </LinearLayout>
</LinearLayout>
