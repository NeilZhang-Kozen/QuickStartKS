<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/mp_blue">


        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26px"
            android:layout_centerHorizontal="true"
            android:layout_gravity="center_horizontal"
            android:text="@string/sub_trans_amount_content"
            android:textColor="#ffffff"
            android:textSize="26px"

            android:textStyle="bold"
            android:onClick="showPic"/>

        <TextView
            android:id="@+id/tv_amount"
            android:layout_marginTop="26px"
            android:layout_centerHorizontal="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="33px"
            android:layout_marginRight="33px"
            android:layout_below="@+id/title"
            android:textSize="25px"
            android:textStyle="bold"
            android:onClick="showPic"
            android:textColorHint="@color/gray_eee55"
            android:gravity="center_horizontal"
            android:hint="@string/trans_amount_hint"
            android:textColor="@color/white" />
        <View
            android:layout_below="@+id/tv_amount"
            android:layout_width="wrap_content"
            android:layout_height="1dp"
            android:layout_marginTop="15px"
            android:layout_marginLeft="33px"
            android:layout_marginRight="33px"
            android:background="@color/white"/>
</RelativeLayout>